#!@PYTHON@


import os
import sys
import signal
import locale
import gettext

VERSION = '@VERSION@'
pkgdatadir = '@pkgdatadir@'
localedir = '@localedir@'

sys.path.insert(1, pkgdatadir)
signal.signal(signal.SIGINT, signal.SIG_DFL)
locale.bindtextdomain('souvenir', localedir)
locale.textdomain('souvenir')
gettext.bindtextdomain('souvenir', localedir)
gettext.textdomain('souvenir')

if __name__ == '__main__':
    import gi

    from gi.repository import Gio
    resource = Gio.Resource.load(os.path.join(pkgdatadir, 'souvenir.gresource'))
    resource._register()

    from libsouvenir.main import main
    sys.exit(main(VERSION))
